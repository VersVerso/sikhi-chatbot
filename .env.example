# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=sggs_chunks

# RAG behavior
RAG_TOP_K=8
RAG_MIN_CONFIDENCE=0.25
RAG_MAX_CONTEXT_POINTS=16

# Source controls
ALLOW_YOUTUBE_SOURCES=false
NEXT_PUBLIC_ALLOW_YOUTUBE_SOURCES=false

# Optional app URL
NEXT_PUBLIC_APP_BASE_URL=http://localhost:3000

# Optional ingest source (fallback default is the SikhNet SGGS Gurmukhi PDF)
SGGS_PDF_URL=https://www.sikhnet.com/files/ereader/SGGS%20%5BGurmukhi%5D.pdf
INGEST_EMBEDDING_BATCH_SIZE=50
INGEST_UPSERT_BATCH_SIZE=128
